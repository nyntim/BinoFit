+- (void)results_saveDietarySample:(NSDictionary *)input callback:(RCTResponseSenderBlock)callback
+{
+    NSString *type = [RCTAppleHealthKit stringFromOptions:input key:@"type" withDefault:@""];
+    HKQuantityType *quantityType = nil;
+    if ([type isEqualToString:@"EnergyConsumed"]) {
+        quantityType = [HKQuantityType quantityTypeForIdentifier:HKQuantityTypeIdentifierDietaryEnergyConsumed];
+    } else if ([type isEqualToString:@"Protein"]) {
+        quantityType = [HKQuantityType quantityTypeForIdentifier:HKQuantityTypeIdentifierDietaryProtein];
+    } else if ([type isEqualToString:@"Carbohydrates"]) {
+        quantityType = [HKQuantityType quantityTypeForIdentifier:HKQuantityTypeIdentifierDietaryCarbohydrates];
+    } else if ([type isEqualToString:@"FatTotal"]) {
+        quantityType = [HKQuantityType quantityTypeForIdentifier:HKQuantityTypeIdentifierDietaryFatTotal];
+    } else {
+        callback(@[RCTMakeError(@"Unknown dietary type", nil, nil)]);
+        return;
+    }
+
+    double value = [RCTAppleHealthKit doubleValueFromOptions:input];
+    NSDate *startDate = [RCTAppleHealthKit dateFromOptions:input key:@"startDate" withDefault:[NSDate date]];
+    NSDate *endDate = [RCTAppleHealthKit dateFromOptions:input key:@"endDate" withDefault:startDate];
+    HKUnit *unit = [RCTAppleHealthKit hkUnitFromOptions:input key:@"unit" withDefault:[HKUnit gramUnit]];
+    NSDictionary *metadata = [RCTAppleHealthKit metadataFromOptions:input withDefault:nil];
+
+    HKQuantity *quantity = [HKQuantity quantityWithUnit:unit doubleValue:value];
+    HKQuantitySample *sample = [HKQuantitySample quantitySampleWithType:quantityType
+                                                               quantity:quantity
+                                                              startDate:startDate
+                                                                endDate:endDate
+                                                               metadata:metadata];
+
+    [self.healthStore saveObject:sample withCompletion:^(BOOL success, NSError *error) {
+        if (!success) {
+            callback(@[RCTMakeError(@"An error occured while saving the dietary sample", error, nil)]);
+            return;
+        }
+        callback(@[[NSNull null], [sample.UUID UUIDString]]);
+    }];
+}
+
+- (void)results_deleteHealthSample:(NSString *)type uuid:(NSString *)oid callback:(RCTResponseSenderBlock)callback
+{
+    HKObjectType *objectType = nil;
+    if ([type isEqualToString:@"BodyMass"]) {
+        objectType = [HKQuantityType quantityTypeForIdentifier:HKQuantityTypeIdentifierBodyMass];
+    } else if ([type isEqualToString:@"EnergyConsumed"]) {
+        objectType = [HKQuantityType quantityTypeForIdentifier:HKQuantityTypeIdentifierDietaryEnergyConsumed];
+    } else if ([type isEqualToString:@"Protein"]) {
+        objectType = [HKQuantityType quantityTypeForIdentifier:HKQuantityTypeIdentifierDietaryProtein];
+    } else if ([type isEqualToString:@"Carbohydrates"]) {
+        objectType = [HKQuantityType quantityTypeForIdentifier:HKQuantityTypeIdentifierDietaryCarbohydrates];
+    } else if ([type isEqualToString:@"FatTotal"]) {
+        objectType = [HKQuantityType quantityTypeForIdentifier:HKQuantityTypeIdentifierDietaryFatTotal];
+    } else if ([type isEqualToString:@"Workout"]) {
+        objectType = [HKObjectType workoutType];
+    } else {
+        callback(@[RCTMakeError(@"Unknown Health sample type", nil, nil)]);
+        return;
+    }
+
+    NSUUID *uuid = [[NSUUID alloc] initWithUUIDString:oid];
+    NSPredicate *uuidPredicate = [HKQuery predicateForObjectWithUUID:uuid];
+    [self.healthStore deleteObjectsOfType:objectType predicate:uuidPredicate withCompletion:^(BOOL success, NSUInteger deletedObjectCount, NSError * _Nullable error) {
+        if (!success) {
+            callback(@[RCTMakeError(@"An error occured while deleting the Health sample", error, nil)]);
+            return;
+        }
+        callback(@[[NSNull null], @(deletedObjectCount)]);
+    }];
+}
+
