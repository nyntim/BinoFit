{
  "expo": {
    "name": "BinoFit",
    "slug": "binofit",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "2.1.45",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "binofit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "NSHealthShareUsageDescription": "Used to read your activity data",
        "NSHealthUpdateUsageDescription": "Used to save your nutrition data"
      },
      "bundleIdentifier": "com.nyn.tim.binofit"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nyn.tim.binofit",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "BinoFit uses the camera to scan food barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "react-native-health",
      "expo-font",
      "expo-image",
      "expo-notifications",
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "085ee170-665b-4bed-aeaf-7fb02a639423"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/085ee170-665b-4bed-aeaf-7fb02a639423"
    }
  }
}
